<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ report.pdf_path.name }} — format check</title>
<style>
  body { font-family: -apple-system, system-ui, sans-serif; margin: 2em; color: #222; }
  h1 { margin-bottom: 0.2em; }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; color: white; font-size: 0.9em; }
  .pass { background: #2a9d3f; }
  .warn { background: #e08e00; }
  .fail { background: #c62828; }
  table { border-collapse: collapse; width: 100%; margin: 1em 0; }
  th, td { border-bottom: 1px solid #ddd; padding: 6px 10px; text-align: left; font-size: 0.9em; vertical-align: top; }
  th { background: #f5f5f5; }
  .sev-error { color: #c62828; font-weight: 600; }
  .sev-warning { color: #e08e00; font-weight: 600; }
  .sev-info { color: #666; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1em; }
  .grid figure { margin: 0; border: 1px solid #ddd; padding: 6px; }
  .grid img { width: 100%; height: auto; display: block; }
  .meta { color: #555; font-size: 0.9em; }
  .legend span { display: inline-block; margin-right: 1em; }
  .legend i { display: inline-block; width: 12px; height: 12px; vertical-align: middle; margin-right: 4px; }
  .cleared-badge { background: #2a9d3f; }
  .action-btn { background: none; border: 1px solid #bbb; border-radius: 4px; padding: 4px 10px; font-size: 0.9em; cursor: pointer; margin-left: 0.5em; }
  .action-btn:hover { background: #eef; }
  .clear-note { color: #555; font-size: 0.9em; font-style: italic; margin-left: 0.5em; }
</style>
</head>
<body data-slug="{{ slug }}" data-hash="{{ pdf_hash }}" data-status="{{ report.status }}">
<p><a href="../index.html">← batch index</a></p>
<h1>{{ report.pdf_path.name }}
  <span id="status-badge" class="badge {{ report.status }}">{{ report.status | upper }}</span>
  <button id="clear-btn" class="action-btn" onclick="toggleClear()">clear</button>
  <button class="action-btn" onclick="exportCleared()">export cleared.json</button>
  <input type="file" id="import-file" accept=".json,application/json" style="display:none" onchange="importCleared(event)">
  <button class="action-btn" onclick="document.getElementById('import-file').click()">import cleared.json</button>
  <span id="clear-note" class="clear-note"></span>
</h1>
<p class="meta">
  Profile: <b>{{ report.profile_name }}</b> ·
  Pages: {{ report.page_count }}
  (body {{ report.classification.body | length }},
  ethics {{ report.classification.ethics | length }},
  refs {{ report.classification.references | length }},
  appendix {{ report.classification.appendix | length }}) ·
  Body font: {{ report.body_font or "?" }} @ {{ report.body_font_size }}pt
</p>
<p class="legend">
  <span><i style="background:#00aa00"></i>expected text block</span>
  <span><i style="background:#dc1414"></i>font issue</span>
  <span><i style="background:#f08c00"></i>geometry issue</span>
</p>

{% if issue_groups %}
<h2>Issues ({{ report.n_errors }} error, {{ report.n_warnings }} warning)</h2>
{% for label, key, items in issue_groups %}
<h3 id="cat-{{ key }}">{{ label }}
  <span class="meta">({{ items | length }})</span></h3>
<table>
  <tr><th>Severity</th><th>Check</th><th>Page</th><th>Message</th><th>Expected</th><th>Actual</th></tr>
  {% for issue in items %}
  <tr>
    <td class="sev-{{ issue.severity }}">{{ issue.severity }}</td>
    <td>{{ issue.check }}</td>
    <td>{{ issue.page or "" }}</td>
    <td>{{ issue.message }}</td>
    <td>{{ issue.expected }}</td>
    <td>{{ issue.actual }}</td>
  </tr>
  {% endfor %}
</table>
{% endfor %}
{% else %}
<p><b>No issues detected.</b></p>
{% endif %}

<h2>Rendered pages</h2>
<div class="grid">
  {% for path in report.rendered_pages %}
  <figure>
    <img src="{{ path.name }}" alt="page">
    <figcaption>{{ path.name }}</figcaption>
  </figure>
  {% endfor %}
</div>
<script>
const STORAGE_KEY = 'fcheck.cleared.v1';
const slug = document.body.dataset.slug;
const hash = document.body.dataset.hash;
const origStatus = document.body.dataset.status;
const key = slug + '@' + hash;

function readStore() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
  catch { return {}; }
}
function writeStore(s) { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); }

function applyState() {
  const store = readStore();
  const entry = store[key];
  const badge = document.getElementById('status-badge');
  const btn = document.getElementById('clear-btn');
  const note = document.getElementById('clear-note');
  if (entry) {
    badge.textContent = 'CLEARED';
    badge.classList.remove('fail', 'warn', 'pass');
    badge.classList.add('cleared-badge');
    btn.textContent = 'unclear';
    note.textContent = entry.note ? '“' + entry.note + '”' : '';
  } else {
    badge.textContent = origStatus.toUpperCase();
    badge.classList.remove('cleared-badge', 'fail', 'warn', 'pass');
    badge.classList.add(origStatus);
    btn.textContent = 'clear';
    note.textContent = '';
  }
}

function toggleClear() {
  const store = readStore();
  if (key in store) {
    delete store[key];
  } else {
    store[key] = {
      hash: hash,
      note: '',
      cleared_at: new Date().toISOString(),
    };
  }
  writeStore(store);
  applyState();
}

function exportCleared() {
  const store = readStore();
  const cleared = {};
  if (key in store) cleared[slug] = store[key];
  const payload = JSON.stringify({version: 1, cleared}, null, 2) + '\n';
  const blob = new Blob([payload], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'cleared.json';
  a.click();
  URL.revokeObjectURL(url);
}

function importCleared(ev) {
  const file = ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const data = JSON.parse(reader.result);
      const incoming = data && data.cleared ? data.cleared : {};
      const store = readStore();
      let added = 0;
      for (const [s, entry] of Object.entries(incoming)) {
        if (!entry || !entry.hash) continue;
        store[s + '@' + entry.hash] = entry;
        added++;
      }
      writeStore(store);
      applyState();
      alert('Imported ' + added + ' cleared entries.');
    } catch (e) { alert('Import failed: ' + e.message); }
    ev.target.value = '';
  };
  reader.readAsText(file);
}

window.addEventListener('storage', e => { if (e.key === STORAGE_KEY) applyState(); });
applyState();
</script>
</body>
</html>
